ENVIRONMENT=development            # set to "production" to hide /docs and enforce strict checks
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bookstore

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# First admin, created on startup only if no admin exists yet. Remove the password from .env afterwards.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@12345

CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
APP_TIMEZONE=Asia/Kolkata
